# Python 运行时
__pycache__/
*.py[cod]
*.pyo

# 执行层运行时产物（快照/飞轮/报告/记忆/沙箱/测试/数据库/截图/图片/通知）
.guardian/
.agent_flywheel/
.agent_memory.json
.poc_reports/
.sandbox_tmp/
.test_tmp/
.ace_shots/
.ace_images/
.ace_goals.json
.ace_sessions/
.ace_kb/
agent.db
notifications.log
*.jsonl

# 虚拟环境与依赖
.venv/
venv/

# Go 执行器编译产物（宿主按 ace_executor.py 里的固定名去找它，就地编译）
executor/ace-executor
executor/ace-executor.exe
executor/executor.exe


# 日志与临时文件
*.log
*.tmp

# 冒烟脚本的原始证据：每次跑都重写，属于本机产物（脚本自己会重建目录）
e2e/_rel03_evidence/

# 打包产物（packaging/build_exe.ps1 生成；要发布的是 dist/ace 整个目录，不入库）
build/
dist/
packaging/_smoke/

# 基准报告本机生成、不入库（CI bench 任务在工作区自产自销）
benchmarks/results/

# 示例场景：用户自己丢进去的文档不入库，只保留占位说明
examples/02_document_parsing/drop_docs_here/*
!examples/02_document_parsing/drop_docs_here/README.md

# 本地虚拟环境（setup_env.py 建的，不入库）
.ace_env/
# 注意：vendor/*.whl 是**故意入库**的——离线环境靠它 `setup_env.py --ensure` 一把装好，
# 所以这里没有 vendor 的忽略规则。详见 vendor/README.md。
